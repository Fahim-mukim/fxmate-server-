# Copy to .env for local development. Never commit the real .env file.
PORT=5000
MONGODB_URI=
CLIENT_ORIGIN=http://localhost:3000

# Set explicitly in production:
# NODE_ENV=production

# Better Auth JWT/JWKS contract. Values must match the Client's canonical
# BETTER_AUTH_URL-derived issuer/audience and its /api/auth/jwks endpoint.
AUTH_JWT_ISSUER=
AUTH_JWT_JWKS_URL=
AUTH_JWT_AUDIENCE=
AUTH_JWT_ALGORITHMS=EdDSA
