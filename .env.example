# Copy to .env for local development. Never commit the real .env file.
PORT=5000
MONGODB_URI=
CLIENT_ORIGIN=http://localhost:3000

# Set explicitly in production:
# NODE_ENV=production

# Better Auth JWT/JWKS contract. Values must match the Client's canonical
# BETTER_AUTH_URL-derived issuer/audience and its /api/auth/jwks endpoint.
AUTH_JWT_ISSUER=
AUTH_JWT_JWKS_URL=
AUTH_JWT_AUDIENCE=
AUTH_JWT_ALGORITHMS=EdDSA

# Server-to-server secret used only for application-user provisioning.
# Keep this value server-side on both applications; never use NEXT_PUBLIC_.
FIXMATE_PROVISIONING_SECRET=

# Fail-closed authentication test mode. This uses the owner-approved shared
# database `fixmate`; it is NOT database-isolated. Set FIXMATE_TEST_MODE=true only
# when every value below is configured for a test run.
# These names are intentionally commented out; do not uncomment them in normal mode.
# FIXMATE_TEST_MODE=true
# FIXMATE_TEST_MONGODB_URI=
# FIXMATE_TEST_DATABASE_NAME=fixmate
# FIXMATE_TEST_PROVISIONING_SECRET=
# FIXMATE_TEST_CLIENT_ORIGIN=http://localhost:3000
# FIXMATE_TEST_AUTH_JWT_ISSUER=http://localhost:3000
# FIXMATE_TEST_AUTH_JWT_JWKS_URL=http://localhost:3000/api/auth/jwks
# FIXMATE_TEST_AUTH_JWT_AUDIENCE=http://localhost:3000
# FIXMATE_TEST_AUTH_JWT_ALGORITHMS=EdDSA
