# Copy to .env for local development. Never commit the real .env file.
PORT=5000
MONGODB_URI=
CLIENT_ORIGIN=http://localhost:3000

# Set explicitly in production:
# NODE_ENV=production

# Better Auth JWT/JWKS contract. Values must match the Client's canonical
# BETTER_AUTH_URL-derived issuer/audience and its /api/auth/jwks endpoint.
AUTH_JWT_ISSUER=
AUTH_JWT_JWKS_URL=
AUTH_JWT_AUDIENCE=
AUTH_JWT_ALGORITHMS=EdDSA

# Server-only ImgBB key. Never expose this through a NEXT_PUBLIC_* variable,
# the Client app, logs, or Git. Keep the real value only in local .env.
IMGBB_API_KEY=

# Server-only Stripe secrets for the later Checkout/webhook phases. Use a Stripe
# test-mode secret key locally; the CLI webhook secret and the Dashboard webhook
# secret are different values of STRIPE_WEBHOOK_SECRET in separate environments.
# Never place these in Client env files, NEXT_PUBLIC_*, logs, or Git.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
